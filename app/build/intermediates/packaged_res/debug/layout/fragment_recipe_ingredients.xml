<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Add Missing Ingredients CTA Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_missing_shopping"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:text="@string/btn_add_missing"
        android:textColor="@color/primary_orange_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:strokeColor="@color/primary_orange" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ingredients_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
