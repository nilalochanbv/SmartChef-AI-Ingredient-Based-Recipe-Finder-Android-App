<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cooking_bg"
    android:padding="20dp">

    <!-- Top Header with Close Button -->
    <RelativeLayout
        android:id="@+id/layout_cooking_header"
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/btn_close_cooking"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_timer_circle"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/cooking_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-black"
            android:text="@string/cooking_mode_title"
            android:textColor="@color/cooking_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Step Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/layout_cooking_footer"
        android:layout_below="@id/layout_cooking_header"
        android:gravity="center"
        android:orientation="vertical">

        <!-- STEP Badge -->
        <TextView
            android:id="@+id/tv_cooking_step_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_indicator"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="STEP 1 / 6"
            android:textColor="@color/primary_orange"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Large Instruction Text -->
        <TextView
            android:id="@+id/tv_cooking_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingExtra="8dp"
            android:text="Heat oil in a pan until warm and shimmering."
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Circular Countdown Timer Container -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_timer_circle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_timer_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="05:00"
                    android:textColor="@color/cooking_orange"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_timer_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap to Start ▶"
                    android:textColor="@color/cooking_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Navigation Footer -->
    <LinearLayout
        android:id="@+id/layout_cooking_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cooking_prev"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_previous"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:strokeColor="@color/cooking_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cooking_next"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_orange_gradient_button"
            android:text="@string/btn_next_step"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="28dp" />
    </LinearLayout>
</RelativeLayout>
