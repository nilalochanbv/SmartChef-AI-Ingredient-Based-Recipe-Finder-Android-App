<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. FLOATING INGREDIENTS -->

    <!-- Top-Left Tomato -->
    <ImageView
        android:id="@+id/iv_ingredient_tomato"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:contentDescription="Fresh Tomato"
        android:elevation="4dp"
        android:src="@drawable/ic_ingredient_tomato"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top-Right Cut Onion Slice -->
    <ImageView
        android:id="@+id/iv_ingredient_onion"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="Cut Onion Ring"
        android:elevation="4dp"
        android:src="@drawable/ic_ingredient_onion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Center Green Leaf -->
    <ImageView
        android:id="@+id/iv_ingredient_leaf_top"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="90dp"
        android:contentDescription="Green Basil Leaf"
        android:elevation="4dp"
        android:rotation="45"
        android:src="@drawable/ic_ingredient_leaf"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Middle-Left Red Chili Pepper -->
    <ImageView
        android:id="@+id/iv_ingredient_chili"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:contentDescription="Red Chili Pepper"
        android:elevation="4dp"
        android:rotation="-20"
        android:src="@drawable/ic_ingredient_chili"
        app:layout_constraintBottom_toTopOf="@id/iv_bottom_waves"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4" />

    <!-- Middle-Right Green Leaf -->
    <ImageView
        android:id="@+id/iv_ingredient_leaf_bottom"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="18dp"
        android:contentDescription="Green Mint Leaf"
        android:elevation="4dp"
        android:rotation="-35"
        android:src="@drawable/ic_ingredient_leaf"
        app:layout_constraintBottom_toTopOf="@id/iv_bottom_waves"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45" />

    <!-- 2. GOLDEN SPARKLES AROUND LOGO -->

    <ImageView
        android:id="@+id/iv_sparkle_1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Sparkle"
        android:src="@drawable/ic_sparkle_star"
        app:layout_constraintEnd_toEndOf="@id/iv_splash_logo"
        app:layout_constraintTop_toTopOf="@id/iv_splash_logo" />

    <ImageView
        android:id="@+id/iv_sparkle_2"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="28dp"
        android:contentDescription="Sparkle"
        android:src="@drawable/ic_sparkle_star"
        app:layout_constraintStart_toStartOf="@id/iv_splash_logo"
        app:layout_constraintTop_toTopOf="@id/iv_splash_logo" />

    <ImageView
        android:id="@+id/iv_sparkle_3"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Sparkle"
        android:src="@drawable/ic_sparkle_star"
        app:layout_constraintBottom_toBottomOf="@id/iv_splash_logo"
        app:layout_constraintEnd_toEndOf="@id/iv_splash_logo" />

    <ImageView
        android:id="@+id/iv_sparkle_4"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="Sparkle"
        android:src="@drawable/ic_sparkle_star"
        app:layout_constraintBottom_toBottomOf="@id/iv_splash_logo"
        app:layout_constraintStart_toStartOf="@id/iv_splash_logo" />

    <!-- 3. BRAND LOGO (Chef Hat + Smiling Pot) -->

    <ImageView
        android:id="@+id/iv_splash_logo"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:contentDescription="SmartChef Logo"
        android:src="@drawable/ic_logo_smartchef_v2"
        app:layout_constraintBottom_toTopOf="@id/iv_bottom_waves"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28" />

    <!-- 4. APP TITLE AND TAGLINE GROUP -->

    <LinearLayout
        android:id="@+id/layout_text_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_splash_logo">

        <!-- Title: SmartChef AI -->
        <LinearLayout
            android:id="@+id/ll_title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_smart_chef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="SmartChef"
                android:textColor="@color/brand_orange"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="AI"
                android:textColor="@color/pot_dark"
                android:textSize="34sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tagline -->
        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Accent Divider -->
        <ImageView
            android:id="@+id/iv_chef_divider"
            android:layout_width="120dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Divider"
            android:src="@drawable/ic_chef_divider" />
    </LinearLayout>

    <!-- 5. BOTTOM WAVES AND STEAMING POT SECTION -->

    <!-- Layered Bottom Waves -->
    <ImageView
        android:id="@+id/iv_bottom_waves"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:contentDescription="Bottom Waves"
        android:scaleType="fitXY"
        android:src="@drawable/bg_splash_waves"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Steam Floating Graphic -->
    <ImageView
        android:id="@+id/iv_steam"
        android:layout_width="70dp"
        android:layout_height="90dp"
        android:layout_marginBottom="110dp"
        android:contentDescription="Pot Steam"
        android:elevation="6dp"
        android:src="@drawable/ic_steam_curve"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Glowing Pot -->
    <ImageView
        android:id="@+id/iv_bottom_pot"
        android:layout_width="120dp"
        android:layout_height="84dp"
        android:layout_marginBottom="55dp"
        android:contentDescription="Steaming Cooking Pot"
        android:elevation="8dp"
        android:src="@drawable/ic_bottom_steaming_pot"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 6. ANIMATED PROGRESS INDICATOR BAR -->

    <!-- Track Background -->
    <FrameLayout
        android:id="@+id/fl_progress_track"
        android:layout_width="200dp"
        android:layout_height="6dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_progress_track"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Fill Bar -->
        <View
            android:id="@+id/v_progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_progress_fill" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
